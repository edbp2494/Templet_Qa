<?xml version="1.0" encoding="UTF-8"?>
<TestSuiteCollectionEntity>
   <description>Coleccion full de validaciones importantes por plataforma. Tracking incluido dentro de Builders. Version v3 para evitar metadata cacheada y errores de planning.</description>
