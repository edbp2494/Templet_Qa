# Normaliza line endings: git almacena LF, checkout según el OS
* text=auto

# Groovy/Katalon — forzar LF en repo
*.groovy text eol=lf
*.ts     text eol=lf
*.tc     text eol=lf
*.tsc    text eol=lf
*.rs     text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.csv    text eol=lf
*.json   text eol=lf
*.prj    text eol=lf
*.ps1    text eol=lf
*.properties text eol=lf

# Binarios — no tocar
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.zip    binary
*.jar    binary
*.class  binary
